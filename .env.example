# Salin berkas ini menjadi .env (sudah di-gitignore) lalu isi dengan nilai
# rahasia yang sesungguhnya. JANGAN PERNAH commit .env ke git.
#
#   cp .env.example .env
#
# Khusus VPS publik (Oracle Cloud dkk): WAJIB ganti seluruh nilai contoh
# di bawah ini — kredensial default tidak aman untuk instance yang
# terhubung ke internet.

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow123
POSTGRES_DB=mlflow

# Backblaze B2 (S3-compatible) — artifact store MLflow (model bundle
# di-upload LANGSUNG dari client ke sini, tidak lewat Cloudflare Tunnel).
# B2_ENDPOINT_URL didapat dari halaman bucket B2, formatnya:
#   https://s3.<region>.backblazeb2.com   (contoh: https://s3.us-west-004.backblazeb2.com)
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=mlflow-artifact
B2_KEY_ID=005a7d1891ad2f10000000001
B2_APPLICATION_KEY=K005YWs+gvkqlJ2Oa+3CopP036GuqFY