.metaflow/
# Clone manual Netflix/metaflow-service & Netflix/metaflow-ui untuk build image
# UI backend/frontend (tidak ada image publik untuk keduanya) — lihat Next_Step.md.
.metaflow-ui-stack/

# ── DVC (cache & temp, config resmi ada di .dvc/.gitignore) ──────────────────
.dvc/tmp/
.dvc/cache/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Log & Debug ───────────────────────────────────────────────────────────────
*.log
logs/

